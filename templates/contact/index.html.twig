{% extends 'base.html.twig' %}

{% block title %}Contact | SK Systems{% endblock %}
{% block meta_description %}Un projet en tête ? Contactez SK Systems pour discuter de votre site web, application ou MVP. Réponse sous 24h, devis gratuit.{% endblock %}
{% block og_title %}Contact | SK Systems{% endblock %}

{% block body %}

    <section class="page-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <span class="hero-badge page-hero-eyebrow">CONTACTEZ-NOUS</span>

                    <h1 class="display-4 fw-bold text-white mt-3">
                        Un projet en tête ?<br>
                        <span class="text-gradient">Discutons-en.</span>
                    </h1>

                    <p class="page-hero-lead mt-4">
                        Nous sommes à votre écoute pour comprendre vos besoins
                        et vous proposer la solution digitale la plus adaptée.
                    </p>

                    <div class="tech-trust-row mt-4">
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                            </span>
                            <span>
                                <strong>Réponse rapide</strong>
                                Nous vous répondons sous 24h.
                            </span>
                        </div>
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            </span>
                            <span>
                                <strong>Écoute &amp; conseil</strong>
                                Un accompagnement personnalisé.
                            </span>
                        </div>
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                            </span>
                            <span>
                                <strong>Devis gratuit</strong>
                                Sans engagement et transparent.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="contact-hero-visual">

                        <span class="tech-chip contact-chip--phone" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6.3 6.3l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2.1z"/></svg>
                        </span>
                        <span class="tech-chip contact-chip--mail" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
                        </span>
                        <span class="tech-chip contact-chip--pin" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </span>

                        <div class="contact-envelope">
                            <span class="contact-envelope-flap"></span>
                            <div class="contact-envelope-letter">
                                <img src="{{ asset('images/logos/sk-monogramme.png') }}" alt="" class="contact-envelope-logo">
                                <span class="hero-float-line"></span>
                                <span class="hero-float-line hero-float-line--short"></span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,60 C280,10 520,90 800,50 C1080,10 1260,80 1440,30 L1440,110 L0,110 Z"/>
        </svg>
    </section>

    <section class="py-5 py-lg-6">
        <div class="container">
            <div class="row g-5">

                <div class="col-lg-4">
                    <span class="section-eyebrow d-block mb-4">Nos coordonnées</span>

                    <div class="contact-info-list">

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6.3 6.3l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2.1z"/></svg>
                            </span>
                            <div>
                                <strong>Téléphone</strong>
                                <span>07 55 46 43 76</span>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
                            </span>
                            <div>
                                <strong>Email</strong>
                                <span>samy.elkniez@sksystems.fr</span>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20z"/></svg>
                            </span>
                            <div>
                                <strong>Site web</strong>
                                <span>sksystems.fr</span>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <span class="contact-info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </span>
                            <div>
                                <strong>Localisation</strong>
                                <span>France<br>Interventions à distance ou sur site</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-lg-8">
                    <span class="section-eyebrow d-block mb-4">Envoyez-nous un message</span>

                    {% for message in app.flashes('contact_success') %}
                        <div class="alert alert-success" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(contactForm, {'attr': {'class': 'contact-form'}}) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(contactForm.name) }}
                                {{ form_widget(contactForm.name, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(contactForm.name) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(contactForm.firstName) }}
                                {{ form_widget(contactForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(contactForm.firstName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(contactForm.email) }}
                                {{ form_widget(contactForm.email, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(contactForm.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(contactForm.phone) }}
                                {{ form_widget(contactForm.phone, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(contactForm.phone) }}
                            </div>
                            <div class="col-12">
                                {{ form_label(contactForm.subject) }}
                                {{ form_widget(contactForm.subject, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(contactForm.subject) }}
                            </div>
                            <div class="col-12">
                                {{ form_label(contactForm.message) }}
                                {{ form_widget(contactForm.message, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                                {{ form_errors(contactForm.message) }}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                            Envoyer le message
                        </button>

                        <p class="quote-form-note">🔒 Vos données sont confidentielles et ne seront jamais partagées.</p>
                    {{ form_end(contactForm) }}
                </div>

            </div>
        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' with {
        cta_title: 'Prêt à concrétiser votre projet ?',
        cta_highlight: 'Demandez votre devis gratuit !',
        cta_text: 'Recevez une estimation personnalisée adaptée à vos besoins.',
        cta_items: ['Devis gratuit et sans engagement', 'Réponse sous 24h', 'Accompagnement dédié'],
    } %}

{% endblock %}
