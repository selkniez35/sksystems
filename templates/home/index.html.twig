{% extends 'base.html.twig' %}

{% block title %}SK Systems - Développement web & solutions digitales{% endblock %}

{% block body %}

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center min-vh-75">

                <div class="col-lg-6">

                    <span class="hero-badge hero-badge--brand mb-3">SK SYSTEMS</span>

                    <h1 class="display-3 fw-bold text-white mt-3">
                        Créateur de<br>
                        <span class="text-gradient">solutions digitales</span><br>
                        sur mesure
                    </h1>

                    <p class="lead text-light opacity-75 mt-4">
                        Sites web, applications web et MVP conçus pour
                        performer et évoluer avec votre activité.
                    </p>

                    <div class="mt-4 d-flex flex-wrap gap-3">
                        <a href="{{ path('app_services') }}" class="btn btn-primary btn-lg">
                            Découvrir nos services ↗
                        </a>
                        <button type="button" class="btn btn-outline-light btn-lg" data-action="quote-modal#open">
                            Demander un devis ↗
                        </button>
                    </div>

                    <div class="hero-features">
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                                <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                            </svg>
                            Performance
                        </div>
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/>
                                <path d="M9 12l2 2 4-4"/>
                            </svg>
                            Sécurité
                        </div>
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 17l6-6 4 4 8-8"/>
                                <path d="M15 6h6v6"/>
                            </svg>
                            Évolutivité
                        </div>
                    </div>

                </div>

                <div class="col-lg-6 mt-5 mt-lg-0">
                    <div class="hero-visual">

                        <div class="hero-cube" aria-hidden="true">
                            <span class="cube-face cube-face--top"></span>
                            <span class="cube-face cube-face--left"></span>
                            <span class="cube-face cube-face--right"></span>
                        </div>

                        <div class="hero-laptop">
                            <div class="hero-laptop-screen">
                                <span class="brand-logo brand-logo--hero"><img src="{{ asset('images/logos/sks-logo-fond-sombre.png') }}" alt="SK Systems"></span>
                            </div>
                            <div class="hero-laptop-base"></div>
                        </div>

                        <div class="hero-float-card">
                            <span class="hero-float-avatar">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"/>
                                    <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
                                </svg>
                            </span>
                            <span class="hero-float-line"></span>
                            <span class="hero-float-line hero-float-line--short"></span>
                            <svg class="hero-float-chart" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
                                <polyline points="0,28 16,18 32,22 48,10 64,16 80,4 100,9"/>
                            </svg>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,40 C280,110 480,0 760,30 C1040,60 1200,10 1440,45 L1440,110 L0,110 Z"/>
        </svg>
    </section>

    <section class="py-5 py-lg-6 solutions-section">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-4">
                    <span class="section-eyebrow">Des solutions adaptées</span>
                    <h2 class="fw-bold">
                        Conçues pour vos objectifs,
                        pensées pour la <span class="text-gradient">performance.</span>
                    </h2>
                </div>

                <div class="col-lg-8">
                    <div class="row g-4">

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"/>
                                        <circle cx="12" cy="12" r="5"/>
                                        <circle cx="12" cy="12" r="1"/>
                                    </svg>
                                </div>
                                <h6>Sur mesure</h6>
                                <p>Chaque projet est unique. Nous concevons des solutions adaptées à vos besoins et à vos objectifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="8 6 2 12 8 18"/>
                                        <polyline points="16 6 22 12 16 18"/>
                                    </svg>
                                </div>
                                <h6>Modernes &amp; robustes</h6>
                                <p>Des technologies actuelles pour des sites et applications rapides, sécurisés et évolutifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/>
                                    </svg>
                                </div>
                                <h6>Orientation résultats</h6>
                                <p>Notre objectif : vous livrer une solution performante qui génère de la valeur concrète.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <h6>Accompagnement dédié</h6>
                                <p>Nous vous accompagnons à chaque étape avec écoute, réactivité et transparence.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    {% include 'partials/_recommendations.html.twig' %}

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
