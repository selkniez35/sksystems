{% extends 'base.html.twig' %}

{% block title %}SK Systems - Développement web & solutions digitales{% endblock %}

{% block body %}

    {% include 'partials/_hero_accueil.html.twig' %}

    <section class="py-5 py-lg-6 solutions-section">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-4">
                    <span class="section-eyebrow">Des solutions adaptées</span>
                    <h2 class="fw-bold">
                        Conçues pour vos objectifs,
                        pensées pour la <span class="text-gradient">performance.</span>
                    </h2>
                </div>

                <div class="col-lg-8">
                    <div class="row g-4">

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"/>
                                        <circle cx="12" cy="12" r="5"/>
                                        <circle cx="12" cy="12" r="1"/>
                                    </svg>
                                </div>
                                <h6>Sur mesure</h6>
                                <p>Chaque projet est unique. Nous concevons des solutions adaptées à vos besoins et à vos objectifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="8 6 2 12 8 18"/>
                                        <polyline points="16 6 22 12 16 18"/>
                                    </svg>
                                </div>
                                <h6>Modernes &amp; robustes</h6>
                                <p>Des technologies actuelles pour des sites et applications rapides, sécurisés et évolutifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/>
                                    </svg>
                                </div>
                                <h6>Orientation résultats</h6>
                                <p>Notre objectif : vous livrer une solution performante qui génère de la valeur concrète.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="solution-item">
                                <div class="solution-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <h6>Accompagnement dédié</h6>
                                <p>Nous vous accompagnons à chaque étape avec écoute, réactivité et transparence.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    {% include 'partials/_recommendations.html.twig' %}

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
