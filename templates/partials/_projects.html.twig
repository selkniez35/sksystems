{% if projects is defined and projects|length > 0 %}
    {% set featured = projects|filter(p => p.image is not null) %}
    {% set others = projects|filter(p => p.image is null) %}

    <section id="realisations" class="py-5 py-lg-6 projects-section">
        <div class="container">

            <div class="text-center mb-5">
                <span class="section-eyebrow">Réalisations</span>
                <h2 class="fw-bold">Ce que j'ai développé</h2>
                <p class="text-muted">Deux plateformes livrées de bout en bout.</p>
            </div>

            {% for project in featured %}
                <div class="case-study {{ loop.index0 is odd ? 'case-study--reverse' : '' }}">
                    <div class="row align-items-center g-4 g-lg-5">

                        <div class="col-lg-7 {{ loop.index0 is odd ? 'order-lg-2' : '' }}">
                            <div class="case-study-visual">
                                <img src="{{ asset(project.image) }}" alt="Page d'accueil de {{ project.name }}" loading="lazy">
                            </div>
                        </div>

                        <div class="col-lg-5 {{ loop.index0 is odd ? 'order-lg-1' : '' }}">
                            <span class="project-client">{{ project.client }}</span>
                            <h3>{{ project.name }}</h3>
                            <p>{{ project.description }}</p>
                            <div class="project-tags">
                                {% for tag in project.tags %}
                                    <span class="project-tag">{{ tag }}</span>
                                {% endfor %}
                            </div>
                            {% if project.url %}
                                <a href="{{ project.url }}" target="_blank" rel="noopener" class="project-link">
                                    Voir le site ↗
                                </a>
                            {% endif %}
                        </div>

                    </div>
                </div>
            {% endfor %}

            {% if others|length > 0 %}
                <div class="row g-4 mt-2">
                    {% for project in others %}
                        <div class="col-md-6 col-lg-4 mx-auto">
                            <div class="project-card">
                                <span class="project-client">{{ project.client }}</span>
                                <h4>{{ project.name }}</h4>
                                <p>{{ project.description }}</p>
                                <div class="project-tags">
                                    {% for tag in project.tags %}
                                        <span class="project-tag">{{ tag }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>
{% endif %}
