{% extends 'base.html.twig' %}

{% block title %}À propos | SK Systems{% endblock %}
{% block meta_description %}SK Systems est une agence spécialisée dans la conception et le développement de solutions digitales sur mesure : sites web, applications web et MVP.{% endblock %}
{% block og_title %}À propos | SK Systems{% endblock %}

{% block body %}

    {% include 'partials/_hero_a_propos.html.twig' %}

    <section class="approche-section">
        <div class="approche-shape approche-shape--left" aria-hidden="true"></div>
        <div class="approche-shape approche-shape--right" aria-hidden="true"></div>

        <div class="container position-relative">

            <div class="approche-header">
                <span class="approche-eyebrow">
                    <span class="approche-eyebrow-line" aria-hidden="true"></span>
                    NOTRE APPROCHE
                    <span class="approche-eyebrow-line" aria-hidden="true"></span>
                </span>
                <h2 class="approche-title">
                    Un accompagnement simple
                    <span>et efficace</span>
                </h2>
            </div>

            <div class="approche-grid">

                <div class="approche-col">
                    <span class="approche-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    </span>
                    <span class="approche-number">01</span>
                    <h3>Écoute &amp; analyse</h3>
                    <p>Nous échangeons sur vos besoins et vos objectifs pour définir la meilleure solution.</p>
                </div>

                <div class="approche-col">
                    <span class="approche-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    </span>
                    <span class="approche-number">02</span>
                    <h3>Développement</h3>
                    <p>Nous concevons une solution sur mesure, performante et adaptée à vos enjeux.</p>
                </div>

                <div class="approche-col">
                    <span class="approche-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                    </span>
                    <span class="approche-number">03</span>
                    <h3>Mise en ligne &amp; suivi</h3>
                    <p>Nous assurons le déploiement et restons à vos côtés pour faire évoluer votre projet.</p>
                </div>

            </div>

        </div>
    </section>

    <section class="mission-section">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-4">
                    <span class="mission-eyebrow">
                        <span class="mission-eyebrow-line" aria-hidden="true"></span>
                        NOTRE MISSION
                    </span>
                    <h2 class="mission-title">
                        Concevoir des solutions digitales
                        <span>qui créent de la valeur</span>
                    </h2>
                    <p class="mission-lead">
                        Nous aidons les entreprises, entrepreneurs et porteurs de projets
                        à se démarquer grâce à des outils digitaux performants, pensés
                        pour durer et évoluer avec leur activité.
                    </p>
                </div>

                <div class="col-lg-8">
                    <span class="mission-eyebrow d-flex mb-4">
                        <span class="mission-eyebrow-line" aria-hidden="true"></span>
                        NOS VALEURS
                    </span>
                    <div class="row g-4 text-center">

                        <div class="col-6 col-lg-3">
                            <div class="valeur-item">
                                <span class="approche-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                                </span>
                                <h5>Qualité</h5>
                                <p>Nous livrons des solutions fiables, sécurisées et testées avec rigueur.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="valeur-item">
                                <span class="approche-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                                </span>
                                <h5>Performance</h5>
                                <p>Nous créons des produits rapides, optimisés et évolutifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="valeur-item">
                                <span class="approche-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                </span>
                                <h5>Écoute</h5>
                                <p>Nous comprenons vos besoins pour proposer des solutions vraiment adaptées.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="valeur-item">
                                <span class="approche-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                                </span>
                                <h5>Transparence</h5>
                                <p>Communication claire, suivi régulier et totale transparence à chaque étape.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="stats-band">
        <svg class="stats-band-curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,80 C360,0 1080,0 1440,80 Z"/>
        </svg>
        <div class="container">
            <div class="row g-4 text-center">

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
                        </span>
                        <span class="stats-band-value">30+</span>
                        <strong>Projets réalisés</strong>
                        <span>Sites web, apps et MVP livrés avec succès.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                        </span>
                        <span class="stats-band-value">20+</span>
                        <strong>Clients satisfaits</strong>
                        <span>Entreprises et entrepreneurs accompagnés.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </span>
                        <span class="stats-band-value">3+</span>
                        <strong>Années d'expérience</strong>
                        <span>Une expertise solide au service de vos projets.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        </span>
                        <span class="stats-band-value">100%</span>
                        <strong>Engagement</strong>
                        <span>Des solutions sur mesure, adaptées à vos objectifs.</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
