{% extends 'base.html.twig' %}

{% block title %}À propos | SK Systems{% endblock %}
{% block meta_description %}SK Systems est une agence spécialisée dans la conception et le développement de solutions digitales sur mesure : sites web, applications web et MVP.{% endblock %}
{% block og_title %}À propos | SK Systems{% endblock %}

{% block body %}

    <section class="page-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <span class="hero-badge page-hero-eyebrow">À PROPOS DE SK SYSTEMS</span>

                    <h1 class="display-4 fw-bold text-white mt-3">
                        Qui <span class="text-gradient">sommes-nous</span> ?
                    </h1>

                    <p class="page-hero-lead mt-4">
                        SK Systems est une agence spécialisée dans la conception et le développement
                        de solutions digitales sur mesure. Sites web, applications web et MVP :
                        nous transformons vos idées en produits performants, évolutifs et adaptés
                        à vos objectifs.
                    </p>

                    <p class="page-hero-lead mt-3">
                        Notre approche allie modernité, rigueur et écoute pour vous accompagner
                        à chaque étape de votre projet, de la conception à la mise en ligne et au-delà.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="about-hero-visual">
                        <div class="about-cube" aria-hidden="true">
                            <span class="cube-face cube-face--top"></span>
                            <span class="cube-face cube-face--left"></span>
                            <span class="cube-face cube-face--right"></span>
                            <img src="{{ asset('images/logos/sk-monogramme.png') }}" alt="" class="about-cube-logo">
                        </div>
                        <div class="about-card about-card--code" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                            <span class="hero-float-line"></span>
                            <span class="hero-float-line hero-float-line--short"></span>
                        </div>
                        <div class="about-card about-card--chart" aria-hidden="true">
                            <svg class="hero-float-chart" viewBox="0 0 100 34" preserveAspectRatio="none">
                                <polyline points="0,28 16,20 32,24 48,12 64,18 80,6 100,10"/>
                            </svg>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,40 C280,110 480,0 760,30 C1040,60 1200,10 1440,45 L1440,110 L0,110 Z"/>
        </svg>
    </section>

    <section class="py-5 py-lg-6 solutions-section">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-4">
                    <span class="section-eyebrow">Notre mission</span>
                    <h2 class="fw-bold">
                        Concevoir des solutions digitales qui créent
                        <span class="text-gradient">de la valeur.</span>
                    </h2>
                    <p class="text-muted mt-3">
                        Nous aidons les entreprises, entrepreneurs et porteurs de projets
                        à se démarquer grâce à des outils digitaux performants, pensés
                        pour durer et évoluer avec leur activité.
                    </p>
                </div>

                <div class="col-lg-8">
                    <span class="section-eyebrow d-block mb-4">Nos valeurs</span>
                    <div class="row g-4 text-center">

                        <div class="col-6 col-lg-3">
                            <div class="feature-item">
                                <div class="icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                                </div>
                                <h5>Qualité</h5>
                                <p>Nous livrons des solutions fiables, sécurisées et testées avec rigueur.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="feature-item">
                                <div class="icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                                </div>
                                <h5>Performance</h5>
                                <p>Nous créons des produits rapides, optimisés et évolutifs.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="feature-item">
                                <div class="icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                </div>
                                <h5>Écoute</h5>
                                <p>Nous comprenons vos besoins pour proposer des solutions vraiment adaptées.</p>
                            </div>
                        </div>

                        <div class="col-6 col-lg-3">
                            <div class="feature-item">
                                <div class="icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                                </div>
                                <h5>Transparence</h5>
                                <p>Communication claire, suivi régulier et totale transparence à chaque étape.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="py-5 py-lg-6 approach-section">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-4">
                    <span class="section-eyebrow">Notre approche</span>
                    <h2 class="fw-bold">
                        Un processus clair pour des projets
                        <span class="text-gradient">réussis.</span>
                    </h2>
                    <p class="text-muted mt-3">
                        Nous suivons une méthode éprouvée pour garantir des résultats
                        à la hauteur de vos attentes.
                    </p>
                </div>

                <div class="col-lg-8">
                    <div class="about-process">

                        <div class="about-process-step">
                            <span class="about-process-number">1</span>
                            <h6>Compréhension</h6>
                            <p>Nous analysons vos besoins, vos objectifs et votre marché pour poser les bonnes bases.</p>
                        </div>

                        <div class="about-process-step">
                            <span class="about-process-number">2</span>
                            <h6>Conception</h6>
                            <p>Nous concevons l'architecture, l'interface et l'expérience utilisateur de votre solution.</p>
                        </div>

                        <div class="about-process-step">
                            <span class="about-process-number">3</span>
                            <h6>Développement</h6>
                            <p>Nous développons avec des technologies modernes, un code propre et sécurisé.</p>
                        </div>

                        <div class="about-process-step">
                            <span class="about-process-number">4</span>
                            <h6>Livraison &amp; suivi</h6>
                            <p>Nous livrons votre solution et restons à vos côtés pour assurer son évolution.</p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="stats-band">
        <svg class="stats-band-curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,80 C360,0 1080,0 1440,80 Z"/>
        </svg>
        <div class="container">
            <div class="row g-4 text-center">

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
                        </span>
                        <span class="stats-band-value">30+</span>
                        <strong>Projets réalisés</strong>
                        <span>Sites web, apps et MVP livrés avec succès.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                        </span>
                        <span class="stats-band-value">20+</span>
                        <strong>Clients satisfaits</strong>
                        <span>Entreprises et entrepreneurs accompagnés.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </span>
                        <span class="stats-band-value">3+</span>
                        <strong>Années d'expérience</strong>
                        <span>Une expertise solide au service de vos projets.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="stats-band-item">
                        <span class="stats-band-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        </span>
                        <span class="stats-band-value">100%</span>
                        <strong>Engagement</strong>
                        <span>Des solutions sur mesure, adaptées à vos objectifs.</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
