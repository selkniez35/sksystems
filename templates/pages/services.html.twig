{% extends 'base.html.twig' %}

{% block title %}Services | SK Systems{% endblock %}
{% block meta_description %}Sites web, applications web et MVP sur mesure : découvrez les services de développement digital proposés par SK Systems.{% endblock %}
{% block og_title %}Services | SK Systems{% endblock %}

{% block body %}

    <section class="page-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <span class="hero-badge page-hero-eyebrow">NOS SERVICES</span>

                    <h1 class="display-4 fw-bold text-white mt-3">
                        Des solutions digitales adaptées
                        <span class="text-gradient">à vos objectifs</span>
                    </h1>

                    <p class="page-hero-lead mt-4">
                        De la conception à la mise en ligne, nous vous accompagnons
                        à chaque étape pour créer des produits performants,
                        évolutifs et centrés sur vos utilisateurs.
                    </p>

                    <div class="hero-features hero-features--no-border mt-4">
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                                <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                            </svg>
                            Performance
                        </div>
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/>
                                <path d="M9 12l2 2 4-4"/>
                            </svg>
                            Sécurité
                        </div>
                        <div class="hero-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 17l6-6 4 4 8-8"/>
                                <path d="M15 6h6v6"/>
                            </svg>
                            Évolutivité
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="services-hero-visual">

                        <div class="hero-cube" aria-hidden="true">
                            <span class="cube-face cube-face--top"></span>
                            <span class="cube-face cube-face--left"></span>
                            <span class="cube-face cube-face--right"></span>
                        </div>

                        <div class="about-card about-card--code services-code-card" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                            <span class="hero-float-line"></span>
                            <span class="hero-float-line hero-float-line--short"></span>
                        </div>

                        <div class="hero-laptop">
                            <div class="hero-laptop-screen hero-laptop-screen--ui">
                                <div class="ui-mock">
                                    <div class="ui-mock-image">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                    </div>
                                    <div class="ui-mock-lines">
                                        <span></span><span></span><span class="short"></span>
                                    </div>
                                    <div class="ui-mock-chips">
                                        <span></span><span></span>
                                    </div>
                                </div>
                            </div>
                            <div class="hero-laptop-base"></div>
                        </div>

                        <div class="mini-phone" aria-hidden="true">
                            <div class="mini-phone-screen">
                                <span class="mini-phone-avatar"></span>
                                <span class="hero-float-line"></span>
                                <span class="hero-float-line hero-float-line--short"></span>
                                <span class="hero-float-line"></span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,40 C280,110 480,0 760,30 C1040,60 1200,10 1440,45 L1440,110 L0,110 Z"/>
        </svg>
    </section>

    <section id="services" class="py-5 py-lg-6">
        <div class="container">

            <div class="text-center mb-5">
                <span class="section-eyebrow">Ce que nous faisons</span>
                <h2 class="fw-bold">Nos services pour <span class="text-gradient">concrétiser vos idées</span></h2>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="service-card">
                        <div class="icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        </div>
                        <h4>Sites web</h4>
                        <p>
                            Des sites vitrines, institutionnels ou e-commerce
                            modernes, rapides et optimisés pour le référencement.
                        </p>
                        <ul>
                            <li>Design sur mesure et responsive</li>
                            <li>Performances optimisées (SEO &amp; vitesse)</li>
                            <li>Facile à administrer</li>
                        </ul>
                        <a href="{{ path('app_contact') }}" class="service-card-link">
                            En savoir plus →
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="service-card">
                        <div class="icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
                        </div>
                        <h4>Applications web</h4>
                        <p>
                            Des applications web sur mesure pour digitaliser
                            vos processus et améliorer votre productivité.
                        </p>
                        <ul>
                            <li>Interfaces intuitives et performantes</li>
                            <li>Solutions sécurisées et évolutives</li>
                            <li>Adaptées à vos workflows</li>
                        </ul>
                        <a href="{{ path('app_contact') }}" class="service-card-link">
                            En savoir plus →
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="service-card">
                        <div class="icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                                <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                            </svg>
                        </div>
                        <h4>MVP</h4>
                        <p>
                            Validez votre idée rapidement avec un MVP fiable,
                            évolutif et prêt à convaincre vos utilisateurs.
                        </p>
                        <ul>
                            <li>Développement rapide et itératif</li>
                            <li>Fonctionnalités essentielles</li>
                            <li>Prêt pour les tests et les investisseurs</li>
                        </ul>
                        <a href="{{ path('app_contact') }}" class="service-card-link">
                            En savoir plus →
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
