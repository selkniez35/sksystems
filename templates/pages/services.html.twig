{% extends 'base.html.twig' %}

{% block title %}Services | SK Systems{% endblock %}
{% block meta_description %}Sites web, applications web et MVP sur mesure : découvrez les services de développement digital proposés par SK Systems.{% endblock %}
{% block og_title %}Services | SK Systems{% endblock %}

{% block body %}

    {% include 'partials/_hero_services.html.twig' %}

    <section class="services-grid-section">
        <div class="services-grid-shape services-grid-shape--left" aria-hidden="true"></div>
        <div class="services-grid-shape services-grid-shape--right" aria-hidden="true"></div>

        <div class="container position-relative">

            <div class="services-grid-header">
                <span class="services-grid-eyebrow">
                    <span class="services-grid-eyebrow-line" aria-hidden="true"></span>
                    NOS SERVICES
                    <span class="services-grid-eyebrow-line" aria-hidden="true"></span>
                </span>
                <h2 class="services-grid-title">
                    Des services pour <span>concrétiser vos projets</span>
                </h2>
            </div>

            <div class="row g-4 services-grid-row">

                <div class="col-12 col-lg-4">
                    <div class="service-card-h">
                        <div class="service-card-h-media">
                            <img src="{{ asset('images/services/sites-web.jpg') }}" alt="Illustration du service Sites web" loading="lazy" style="object-position: 38% 46%;">
                        </div>
                        <div class="service-card-h-body">
                            <span class="service-card-h-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                            </span>
                            <h3>Sites web</h3>
                            <p>Des sites modernes, performants et adaptés à votre activité.</p>
                            <button type="button" class="service-card-h-link" data-action="quote-modal#open">
                                Découvrir
                                <span class="service-card-h-arrow" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="service-card-h">
                        <div class="service-card-h-media">
                            <img src="{{ asset('images/services/applications-web.jpg') }}" alt="Illustration du service Applications web" loading="lazy" style="object-position: 58% 55%;">
                        </div>
                        <div class="service-card-h-body">
                            <span class="service-card-h-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                            </span>
                            <h3>Applications web</h3>
                            <p>Des solutions sur mesure pour digitaliser vos besoins et vos processus.</p>
                            <button type="button" class="service-card-h-link" data-action="quote-modal#open">
                                Découvrir
                                <span class="service-card-h-arrow" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="service-card-h">
                        <div class="service-card-h-media">
                            <img src="{{ asset('images/services/mvp.jpg') }}" alt="Illustration du service MVP" loading="lazy" style="object-position: 42% 55%;">
                        </div>
                        <div class="service-card-h-body">
                            <span class="service-card-h-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
                            </span>
                            <h3>MVP</h3>
                            <p>Une première version fonctionnelle pour tester et concrétiser rapidement votre idée.</p>
                            <button type="button" class="service-card-h-link" data-action="quote-modal#open">
                                Découvrir
                                <span class="service-card-h-arrow" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
