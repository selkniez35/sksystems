{% extends 'base.html.twig' %}

{% block title %}Technologies | SK Systems{% endblock %}
{% block meta_description %}Symfony, Vue.js, NestJS, Docker, MySQL, Stripe... découvrez les technologies utilisées par SK Systems pour construire des solutions robustes et évolutives.{% endblock %}
{% block og_title %}Technologies | SK Systems{% endblock %}

{% block body %}

    <section class="page-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <span class="hero-badge page-hero-eyebrow">NOS TECHNOLOGIES</span>

                    <h1 class="display-4 fw-bold text-white mt-3">
                        Des technologies modernes pour
                        des <span class="text-gradient">solutions performantes</span>
                    </h1>

                    <p class="page-hero-lead mt-4">
                        Nous sélectionnons les meilleures technologies pour concevoir
                        des solutions robustes, sécurisées et évolutives, adaptées
                        à vos besoins et à vos objectifs.
                    </p>

                    <div class="tech-trust-row mt-4">
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                            </span>
                            <span>
                                <strong>Fiables &amp; éprouvées</strong>
                                Des technologies stables et largement adoptées.
                            </span>
                        </div>
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 6h6v6"/></svg>
                            </span>
                            <span>
                                <strong>Évolutives</strong>
                                Des solutions conçues pour grandir avec votre activité.
                            </span>
                        </div>
                        <div class="tech-trust-item">
                            <span class="tech-trust-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </span>
                            <span>
                                <strong>Sécurisées</strong>
                                La sécurité et la performance intégrées dès la conception.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="tech-hero-visual">

                        <span class="tech-chip tech-chip--code" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        </span>
                        <span class="tech-chip tech-chip--cloud" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h.79a4.5 4.5 0 1 1 0 9z"/></svg>
                        </span>
                        <span class="tech-chip tech-chip--db" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
                        </span>
                        <span class="tech-chip tech-chip--gear" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        </span>

                        <div class="tech-stack-visual">
                            <span class="tech-stack-layer tech-stack-layer--back"></span>
                            <span class="tech-stack-layer tech-stack-layer--mid"></span>
                            <div class="tech-stack-cube">
                                <span class="cube-face cube-face--top"></span>
                                <span class="cube-face cube-face--left"></span>
                                <span class="cube-face cube-face--right"></span>
                                <img src="{{ asset('images/logos/sk-monogramme.png') }}" alt="" class="tech-stack-cube-logo">
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,60 C280,10 520,90 800,50 C1080,10 1260,80 1440,30 L1440,110 L0,110 Z"/>
        </svg>
    </section>

    <section class="py-5 py-lg-6">
        <div class="container">

            <div class="text-center mb-5">
                <span class="section-eyebrow">Notre stack technologique</span>
                <h2 class="fw-bold">Les outils que nous maîtrisons</h2>
            </div>

            <div class="row g-4">

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#41B883;--tech-color-soft:rgba(65,184,131,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 3h3.5L12 15l6.5-12H22L12 21 2 3z"/><path d="M8 3l4 7 4-7h-3l-1 2-1-2H8z"/></svg>
                        </span>
                        <h6>Vue.js</h6>
                        <p>Framework JavaScript progressif pour créer des interfaces utilisateur réactives et performantes.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#0B1120;--tech-color-soft:rgba(11,17,32,.08)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.2 5h2.4v2.6H16v2.3h-2.8v3.7c0 1 .5 1.4 1.4 1.4.5 0 1-.1 1.4-.3v2.2c-.5.2-1.3.4-2.3.4-2.3 0-3.7-1.2-3.7-3.6V11.9H8V9.6h2v-2.6z"/></svg>
                        </span>
                        <h6>Symfony</h6>
                        <p>Framework PHP robuste et flexible pour des applications web sécurisées et évolutives.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#E0234E;--tech-color-soft:rgba(224,35,78,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2L3 7v10l9 5 9-5V7l-9-5zm0 3.3L18 9v6l-6 3.5L6 15V9l6-3.7z"/></svg>
                        </span>
                        <h6>NestJS</h6>
                        <p>Framework Node.js puissant pour construire des applications back-end modulaires et scalables.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#4479A1;--tech-color-soft:rgba(68,121,161,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14a8 3 0 0 0 16 0V5"/><path d="M4 12a8 3 0 0 0 16 0"/></svg>
                        </span>
                        <h6>MySQL</h6>
                        <p>Base de données relationnelle fiable et performante pour stocker vos données en toute sécurité.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#38BDF8;--tech-color-soft:rgba(56,189,248,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 6c-2.7 0-4.3 1.3-5 4 1-1.3 2.2-1.8 3.5-1.5.8.2 1.3.8 2 1.5 1 1 2.2 2.2 4.5 2.2 2.7 0 4.3-1.3 5-4-1 1.3-2.2 1.8-3.5 1.5-.8-.2-1.3-.8-2-1.5-1-1-2.2-2.2-4.5-2.2zM7 12c-2.7 0-4.3 1.3-5 4 1-1.3 2.2-1.8 3.5-1.5.8.2 1.3.8 2 1.5 1 1 2.2 2.2 4.5 2.2 2.7 0 4.3-1.3 5-4-1 1.3-2.2 1.8-3.5 1.5-.8-.2-1.3-.8-2-1.5-1-1-2.2-2.2-4.5-2.2z"/></svg>
                        </span>
                        <h6>Tailwind CSS</h6>
                        <p>Framework CSS utilitaire pour créer des designs modernes, rapides et personnalisés.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#2496ED;--tech-color-soft:rgba(36,150,237,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="10" width="3.4" height="3.4"/><rect x="6" y="10" width="3.4" height="3.4"/><rect x="10" y="10" width="3.4" height="3.4"/><rect x="6" y="6" width="3.4" height="3.4"/><rect x="10" y="6" width="3.4" height="3.4"/><rect x="10" y="14" width="3.4" height="3.4"/><path d="M22 12.5s-1.5-1.3-4-1c-.3-2-2-3-2-3s-1.7 2-1 4c-2.5.7-4 2.5-4 2.5S12 19 16 19c5.5 0 6-6.5 6-6.5z"/></svg>
                        </span>
                        <h6>Docker</h6>
                        <p>Conteneurisation des applications pour des environnements cohérents et un déploiement simplifié.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#F05032;--tech-color-soft:rgba(240,80,50,.12)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="9" r="2.5"/><path d="M6 8.5v7"/><path d="M6 18c6 0 6-4.5 6-6.5s2-2.5 4-2.5"/></svg>
                        </span>
                        <h6>Git</h6>
                        <p>Gestion de version distribuée pour un suivi de code efficace et collaboratif.</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="tech-card">
                        <span class="tech-card-icon" style="--tech-color:#635BFF;--tech-color-soft:rgba(99,91,255,.12)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 8.1c-1.4 0-2.2.6-2.2 1.5 0 1 1 1.3 2.3 1.7 2.3.7 4 1.6 4 3.9 0 2.6-2.1 4-5.2 4-1.5 0-3-.4-4.3-1.1v-3c1.2.8 2.7 1.3 4.1 1.3 1.4 0 2.3-.6 2.3-1.6 0-1-.8-1.4-2.4-1.9-2.2-.6-3.9-1.5-3.9-3.8 0-2.4 1.9-3.9 4.9-3.9 1.4 0 2.7.3 3.8.9v3c-1.1-.6-2.3-1-3.4-1z"/></svg>
                        </span>
                        <h6>Stripe</h6>
                        <p>Solution de paiement en ligne sécurisée et flexible pour gérer vos transactions.</p>
                    </div>
                </div>

            </div>

            <div class="tech-callout mt-4">
                <span class="tech-callout-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.7 4.5L18 9l-4.3 1.5L12 15l-1.7-4.5L6 9l4.3-1.5z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
                </span>
                <div>
                    <strong>Toujours à la pointe</strong>
                    <p>
                        Nous restons en veille constante pour intégrer les meilleures technologies
                        et pratiques du marché afin de vous offrir des solutions innovantes,
                        performantes et durables.
                    </p>
                </div>
            </div>

        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
