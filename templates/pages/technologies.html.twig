{% extends 'base.html.twig' %}

{% block title %}Technologies | SK Systems{% endblock %}
{% block meta_description %}Vue.js, Symfony, NestJS, PostgreSQL, Docker, Git : découvrez les technologies utilisées par SK Systems pour construire des solutions robustes et évolutives.{% endblock %}
{% block og_title %}Technologies | SK Systems{% endblock %}

{% block body %}

    {% include 'partials/_hero_technologies.html.twig' %}

    <section class="technologies-grid-section">
        <div class="technologies-grid-shape technologies-grid-shape--left" aria-hidden="true"></div>
        <div class="technologies-grid-shape technologies-grid-shape--right" aria-hidden="true"></div>

        <div class="container position-relative">

            <div class="row g-4 technologies-grid-row">

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/vuejs.svg') }}" alt="Vue.js" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">Vue.js</span>
                            <span class="technology-card-tagline">Interfaces modernes et interactives</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/symfony.svg') }}" alt="Symfony" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">Symfony</span>
                            <span class="technology-card-tagline">Applications robustes et évolutives</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/nestjs.svg') }}" alt="NestJS" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">NestJS</span>
                            <span class="technology-card-tagline">APIs performantes et scalables</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/postgresql.svg') }}" alt="PostgreSQL" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">PostgreSQL</span>
                            <span class="technology-card-tagline">Stockage fiable et sécurisé</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/docker.svg') }}" alt="Docker" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">Docker</span>
                            <span class="technology-card-tagline">Environnements standardisés</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="technology-card">
                        <img src="{{ asset('images/technologies/git.svg') }}" alt="Git" class="technology-card-logo" loading="lazy">
                        <div>
                            <span class="technology-card-name">Git</span>
                            <span class="technology-card-tagline">Gestion de version collaborative</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="technologies-perks-band">
                <div class="technologies-perks-row">

                    <div class="technology-perk">
                        <span class="technology-perk-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                        </span>
                        <div>
                            <span class="technology-perk-title">Performance</span>
                            <span class="technology-perk-text">Des applications rapides et optimisées.</span>
                        </div>
                    </div>

                    <div class="technology-perk">
                        <span class="technology-perk-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <div>
                            <span class="technology-perk-title">Sécurité</span>
                            <span class="technology-perk-text">Des solutions fiables et sécurisées.</span>
                        </div>
                    </div>

                    <div class="technology-perk">
                        <span class="technology-perk-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                        </span>
                        <div>
                            <span class="technology-perk-title">Évolutivité</span>
                            <span class="technology-perk-text">Des technologies prêtes pour vos futurs besoins.</span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="technologies-highlight">
                <span class="technologies-highlight-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.5L18 9l-4.3 1.5L12 15l-1.7-4.5L6 9l4.3-1.5z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
                </span>
                <div>
                    <strong>Toujours à la pointe</strong>
                    <p>
                        Nous restons en veille constante pour intégrer les meilleures technologies
                        et pratiques du marché afin de vous offrir des solutions innovantes,
                        performantes et durables.
                    </p>
                </div>
            </div>

        </div>
    </section>

    {% include 'partials/_cta_banner.html.twig' %}

{% endblock %}
